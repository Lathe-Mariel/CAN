# UART0 (CP2102N) is dedicated to SLCAN: no console / log output on it

# 1ms tick: LED pulse / blink timing and low-latency CAN polling
CONFIG_FREERTOS_HZ=1000

# TWAI ISR in IRAM (avoids frame loss during flash writes by NVS)
CONFIG_TWAI_ISR_IN_IRAM=y

# S0 (10kbps) / S1 (20kbps) need a BRP above 128, which only ESP32 rev.2+ supports.
# Uncomment when the board uses rev.2 or newer chips (firmware will then not run on older ones).
# CONFIG_ESP32_REV_MIN_2=y
